# Copy this file to ".env" and change the values to suit you.
# (Lines starting with # are comments and are ignored.)

# Which port the website runs on. http://localhost:3000
PORT=3000

# Your time zone, so "today" and "now" are correct.
# Find yours here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Set to true once the site is served over https:// (always do this on the internet).
# It makes login cookies secure. Leave it false when running on your own computer.
HTTPS=false

# Where the database and uploaded files are kept. Default: the "data" folder.
# DATA_DIR=/var/lib/dmi-admin

# A long random secret that protects login cookies. If you leave it out, one is
# created for you and saved in the data folder.
# SESSION_SECRET=
