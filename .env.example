# Copy this file to ".env" and change the values to suit you.
# (Lines starting with # are comments and are ignored.)
# On Netlify, set these in Project configuration → Environment variables instead.

# Which port the website runs on. http://localhost:3000
PORT=3000

# Set to true once the site is served over https:// (Netlify always is).
# It makes login cookies secure. Leave it false when running on your own computer.
HTTPS=false

# Where the local database and uploaded files are kept. Default: the "data" folder.
# DATA_DIR=/var/lib/dmi-admin

# Use an existing Postgres database instead of the local one "npm start" creates.
# DATABASE_URL=postgres://user:password@host:5432/dmi

# A long random secret that protects login cookies. On your computer one is created
# for you if you leave this out. On Netlify it must be set.
# SESSION_SECRET=

# If set, this code is needed to create the first admin account (recommended on any
# site that's on the internet).
# SETUP_CODE=
