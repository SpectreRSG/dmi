<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/portal-access">← Portal access</a></p>
    <h1>New passphrase</h1>
    <p class="page-sub">For <%= access.name %><%= access.label ? ` · ${access.label}` : '' %></p>
  </div>
</div>
<div class="card card-pad passphrase-card">
  <p>Give this passphrase to <strong><%= access.name %></strong>:</p>
  <p class="passphrase" data-copy-text><%= passphrase %></p>
  <p>They open <strong><%= portalUrl %></strong> and type it in.</p>
  <div class="flash flash-warning">Copy it now — for safety it is <strong>only shown once</strong>. If it gets lost, use "New passphrase" on the Portal access page to make another.</div>
  <div class="form-actions">
    <button type="button" class="btn btn-primary" data-copy="<%= `${portalUrl} – passphrase: ${passphrase}` %>">Copy link and passphrase</button>
    <a class="btn" href="/portal-access">Done</a>
  </div>
</div>
<%- include('../partials/bottom') %>
