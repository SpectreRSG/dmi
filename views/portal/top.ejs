<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= locals.title ? `${title} · ` : '' %><%= settings.company_name %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body class="portal">
<header class="portal-bar">
  <a class="portal-brand" href="/portal"><%- icon('shield') %><span><%= settings.company_name %> schedule</span></a>
  <% if (locals.signedIn) { %>
    <form method="post" action="/portal/sign-out">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn btn-sm btn-ghost"><%- icon('logout') %> Sign out</button>
    </form>
  <% } %>
</header>
<main class="portal-main">
<%- include('../partials/flash') %>
