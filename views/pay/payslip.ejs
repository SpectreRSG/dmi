<%- include('../partials/top') %>
<div class="page-head no-print">
  <div><p class="page-sub"><a href="<%= locals.back || `/pay/${run.id}` %>">← Back to <%= locals.back ? 'my pay' : 'pay run' %></a></p></div>
  <div class="page-actions">
    <% if (locals.timesheetHref) { %><a class="btn" href="<%= timesheetHref %>" target="_blank" rel="noopener"><%- icon('file') %> DMI timesheet</a><% } %>
    <button type="button" class="btn btn-primary" data-print>Print / save as PDF</button>
  </div>
</div>
<% const row = (label, now, year, minus) => `<tr><td>${label}</td><td class="num">${minus && now ? '−' : ''}${money(now)}</td><td class="num muted">${minus && year ? '−' : ''}${money(year)}</td></tr>`; %>
<article class="card payslip">
  <header class="payslip-head">
    <div>
      <h1><%= employer.name %></h1>
      <% for (const line of employer.lines) { %><p class="muted small"><%= line %></p><% } %>
      <p class="muted"><%= w2 ? 'Pay stub' : 'Payment statement (independent contractor)' %><%= run.status === 'draft' ? ' (DRAFT – not final)' : '' %></p>
    </div>
    <dl class="dl compact">
      <dt><%= w2 ? 'Employee' : 'Paid to' %></dt><dd><strong><%= item.first_name %> <%= item.last_name %></strong></dd>
      <dt>ID</dt><dd><%= employeeId %></dd>
      <dt>Position</dt><dd><%= item.position || '—' %></dd>
      <dt>Pay period</dt><dd><%= fmtDate(run.period_start) %> – <%= fmtDate(run.period_end) %></dd>
      <dt>Pay date</dt><dd><%= fmtDate(payDate) %></dd>
    </dl>
  </header>

  <table class="table">
    <thead><tr><th>Earnings</th><th class="num">Hours</th><th class="num">Rate</th><th class="num">This period</th><th class="num">Year to date</th></tr></thead>
    <tbody>
      <tr><td>Regular</td><td class="num"><%= fmtHours(item.regular_hours) %></td><td class="num"><%= money(item.hourly_rate) %></td><td class="num"><%= money(item.regular_pay) %></td><td class="num muted"><%= money(ytd.regular_pay) %></td></tr>
      <% if (item.overtime_hours || ytd.overtime_pay) { %>
        <tr><td>Overtime (<%= item.overtime_multiplier %>×)</td><td class="num"><%= fmtHours(item.overtime_hours) %></td><td class="num"><%= money(item.hourly_rate * item.overtime_multiplier) %></td><td class="num"><%= money(item.overtime_pay) %></td><td class="num muted"><%= money(ytd.overtime_pay) %></td></tr>
      <% } %>
      <% if (item.double_time_hours || ytd.double_time_pay) { %>
        <tr><td>Double time (2×)</td><td class="num"><%= fmtHours(item.double_time_hours) %></td><td class="num"><%= money(item.hourly_rate * 2) %></td><td class="num"><%= money(item.double_time_pay) %></td><td class="num muted"><%= money(ytd.double_time_pay) %></td></tr>
      <% } %>
      <% if (item.sick_hours || ytd.sick_pay) { %>
        <tr><td>Paid sick leave</td><td class="num"><%= fmtHours(item.sick_hours) %></td><td class="num"><%= money(item.hourly_rate) %></td><td class="num"><%= money(item.sick_pay) %></td><td class="num muted"><%= money(ytd.sick_pay) %></td></tr>
      <% } %>
      <% if (item.adjustment || ytd.adjustment) { %>
        <tr><td>Adjustment<%= item.adjustment_note ? `: ${item.adjustment_note}` : '' %></td><td></td><td></td><td class="num"><%= money(item.adjustment) %></td><td class="num muted"><%= money(ytd.adjustment) %></td></tr>
      <% } %>
    </tbody>
    <tfoot>
      <tr><td><strong>Gross pay</strong></td><td class="num"><strong><%= fmtHours(round2(item.regular_hours + item.overtime_hours + item.double_time_hours)) %></strong><br><span class="muted small">hours worked</span></td><td></td><td class="num"><strong><%= money(item.gross_pay) %></strong></td><td class="num"><strong><%= money(ytd.gross_pay) %></strong></td></tr>
    </tfoot>
  </table>

  <table class="table">
    <thead><tr><th><%= w2 ? 'Taxes and deductions' : 'Withheld' %></th><th class="num">This period</th><th class="num">Year to date</th></tr></thead>
    <tbody>
      <% if (w2) { %>
        <%- row('Federal income tax', item.fed_income_tax, ytd.fed_income_tax, true) %>
        <%- row('Social Security', item.social_security, ytd.social_security, true) %>
        <%- row('Medicare', item.medicare, ytd.medicare, true) %>
        <% if (item.additional_medicare || ytd.additional_medicare) { %><%- row('Additional Medicare', item.additional_medicare, ytd.additional_medicare, true) %><% } %>
        <%- row('California income tax', item.ca_income_tax, ytd.ca_income_tax, true) %>
        <%- row('California SDI', item.ca_sdi, ytd.ca_sdi, true) %>
      <% } else { %>
        <%- row(item.fed_income_tax || ytd.fed_income_tax ? 'Federal backup withholding (24%)' : 'No taxes withheld: you pay your own (you get a 1099-NEC)', item.fed_income_tax, ytd.fed_income_tax, true) %>
      <% } %>
      <% if (item.deduction || ytd.deduction) { %><%- row(`Deduction${item.deduction_note ? `: ${escapeXML(item.deduction_note)}` : ''}`, item.deduction, ytd.deduction, true) %><% } %>
    </tbody>
    <tfoot><tr><td><strong>Net pay</strong></td><td class="num"><strong><%= money(item.net_pay) %></strong></td><td class="num"><strong><%= money(ytd.net_pay) %></strong></td></tr></tfoot>
  </table>

  <% if (w2) { %>
    <p><strong>Paid sick leave available: <%= fmtHours(item.sick_balance) %> hours</strong>
      <span class="muted small">(earned <%= fmtHours(item.sick_accrued) %>, used <%= fmtHours(item.sick_hours) %> this period)</span></p>
  <% } %>

  <h2>Hours worked</h2>
  <table class="table compact">
    <thead><tr><th>Date</th><th>Site</th><th>Time</th><th class="num">Break</th><th class="num">Hours</th></tr></thead>
    <tbody>
      <% for (const e of entries) { %>
        <tr><td><%= fmtDay(e.start_at) %></td><td><%= e.site_name || '—' %></td><td><%= fmtRange(e.start_at, e.end_at) %></td><td class="num"><%= e.break_minutes ? `${e.break_minutes} min` : '—' %></td><td class="num"><%= fmtHours(e.hours) %></td></tr>
      <% } %>
    </tbody>
  </table>
</article>
<%- include('../partials/bottom') %>
