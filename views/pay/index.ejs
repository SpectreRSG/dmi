<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Pay</h1>
    <p class="page-sub">Turn approved hours into pay, one period at a time.</p>
  </div>
  <div class="page-actions"><a class="btn btn-primary" href="/pay/new"><%- icon('plus') %> New pay run</a></div>
</div>

<% if (approvedUnpaid) { %>
  <div class="flash flash-info"><%= approvedUnpaid %> approved timesheet entr<%= approvedUnpaid === 1 ? 'y is' : 'ies are' %> not in any pay run yet.</div>
<% } %>

<div class="card">
  <% if (!runs.length) { %>
    <div class="empty">
      <p>No pay runs yet.</p>
      <p class="muted">A pay run collects all <strong>approved</strong> hours between two dates and works out everyone's pay, including overtime.
        <%= overtimeSummary(settings) %></p>
      <p><a class="btn btn-primary" href="/pay/new">Create your first pay run</a></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Period</th><th>Status</th><th class="num">People</th><th class="num">Hours</th><th class="num">Gross pay</th><th></th></tr></thead>
        <tbody>
          <% for (const r of runs) { %>
            <tr>
              <td class="nowrap"><a href="/pay/<%= r.id %>"><strong><%= fmtDate(r.period_start) %> – <%= fmtDate(r.period_end) %></strong></a></td>
              <td><%- statusBadge(r.status) %></td>
              <td class="num"><%= r.people %></td>
              <td class="num"><%= fmtHours(r.hours_total) %></td>
              <td class="num"><%= money(r.gross_total) %></td>
              <td class="actions"><a href="/pay/<%= r.id %>">Open</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/bottom') %>
