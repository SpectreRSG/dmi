<%- include('../partials/top') %>
<% const w2 = item.tax_form === 'W-2'; const draft = run.status === 'draft'; const salaried = item.pay_basis === 'salary'; %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/pay/<%= run.id %>">← Pay run <%= fmtDate(run.period_start) %> – <%= fmtDate(run.period_end) %></a></p>
    <h1><%= item.first_name %> <%= item.last_name %> <%- badge(w2 ? 'W-2 employee' : '1099 contractor', w2 ? 'blue' : 'gray') %><% if (salaried) { %> <%- badge(item.overtime_exempt ? 'Salary, exempt from overtime' : 'Salary', 'green') %><% } %></h1>
    <p class="page-sub">Pay date <%= fmtDate(payDate) %><%= draft ? ' (planned)' : '' %> · <a href="/pay/<%= run.id %>/payslips/<%= item.id %>">Pay stub</a></p>
  </div>
</div>

<div class="grid-2">
  <section class="card card-pad">
    <h2>From gross to net</h2>
    <table class="table compact">
      <tbody>
        <% if (salaried) { %>
          <tr><td>Salary for this pay period<br><span class="muted small"><%= fmtHours(round2(item.regular_hours + item.overtime_hours + item.double_time_hours)) %> h recorded<%= item.overtime_exempt ? '' : `; regular rate ${money(item.hourly_rate)} an hour` %></span></td><td class="num"><%= money(item.salary_pay) %></td></tr>
          <% if (item.extra_hours) { %><tr><td>Extra hours past their schedule: <%= fmtHours(item.extra_hours) %> h × <%= money(item.hourly_rate) %></td><td class="num"><%= money(item.regular_pay) %></td></tr><% } %>
        <% } else { %>
          <tr><td>Regular: <%= fmtHours(item.regular_hours) %> h × <%= money(item.hourly_rate) %></td><td class="num"><%= money(item.regular_pay) %></td></tr>
        <% } %>
        <% if (item.overtime_hours) { %><tr><td>Overtime: <%= fmtHours(item.overtime_hours) %> h × <%= money(item.hourly_rate * item.overtime_multiplier) %></td><td class="num"><%= money(item.overtime_pay) %></td></tr><% } %>
        <% if (item.double_time_hours) { %><tr><td>Double time: <%= fmtHours(item.double_time_hours) %> h × <%= money(item.hourly_rate * 2) %></td><td class="num"><%= money(item.double_time_pay) %></td></tr><% } %>
        <% if (item.meal_premiums) { %><tr><td>Meal break premium: <%= item.meal_premiums %> × <%= money(item.hourly_rate) %></td><td class="num"><%= money(round2(item.meal_premiums * item.hourly_rate)) %></td></tr><% } %>
        <% if (item.rest_premiums) { %><tr><td>Rest break premium: <%= item.rest_premiums %> × <%= money(item.hourly_rate) %></td><td class="num"><%= money(round2(item.rest_premiums * item.hourly_rate)) %></td></tr><% } %>
        <% if (item.sick_hours) { %><tr><td>Paid sick leave: <%= fmtHours(item.sick_hours) %> h <%= salaried ? '(paid in the salary)' : `× ${money(item.hourly_rate)}` %></td><td class="num"><%= money(item.sick_pay) %></td></tr><% } %>
        <% if (item.adjustment) { %><tr><td>Adjustment<%= item.adjustment_note ? `: ${item.adjustment_note}` : '' %></td><td class="num"><%= money(item.adjustment) %></td></tr><% } %>
        <tr><td><strong>Gross pay</strong></td><td class="num"><strong><%= money(item.gross_pay) %></strong></td></tr>
        <% if (w2) { %>
          <tr><td>Federal income tax</td><td class="num">−<%= money(item.fed_income_tax) %></td></tr>
          <tr><td>Social Security</td><td class="num">−<%= money(item.social_security) %></td></tr>
          <tr><td>Medicare</td><td class="num">−<%= money(item.medicare) %></td></tr>
          <% if (item.additional_medicare) { %><tr><td>Additional Medicare</td><td class="num">−<%= money(item.additional_medicare) %></td></tr><% } %>
          <tr><td>California income tax</td><td class="num">−<%= money(item.ca_income_tax) %></td></tr>
          <tr><td>California SDI</td><td class="num">−<%= money(item.ca_sdi) %></td></tr>
        <% } else if (item.fed_income_tax) { %>
          <tr><td>Federal backup withholding (24%)</td><td class="num">−<%= money(item.fed_income_tax) %></td></tr>
        <% } %>
        <% if (item.deduction) { %><tr><td>Deduction<%= item.deduction_note ? `: ${item.deduction_note}` : '' %></td><td class="num">−<%= money(item.deduction) %></td></tr><% } %>
      </tbody>
      <tfoot><tr><td><strong>Net pay</strong></td><td class="num"><strong><%= money(item.net_pay) %></strong></td></tr></tfoot>
    </table>
    <% if (!w2) { %><p class="hint">Independent contractor: overtime rules and payroll taxes don't apply. They pay their own taxes, and get a 1099-NEC.</p><% } %>
  </section>

  <% if (w2) { %>
    <section class="card card-pad">
      <h2>Company taxes on this pay</h2>
      <table class="table compact">
        <tbody>
          <tr><td>Social Security</td><td class="num"><%= money(item.employer_social_security) %></td></tr>
          <tr><td>Medicare</td><td class="num"><%= money(item.employer_medicare) %></td></tr>
          <tr><td>Federal unemployment (FUTA)</td><td class="num"><%= money(item.futa) %></td></tr>
          <tr><td>California UI</td><td class="num"><%= money(item.ca_ui) %></td></tr>
          <tr><td>California ETT</td><td class="num"><%= money(item.ca_ett) %></td></tr>
        </tbody>
      </table>
      <h2 class="spaced">Paid sick leave</h2>
      <dl class="dl compact">
        <dt>Earned this pay run</dt><dd><%= fmtHours(item.sick_accrued) %> h <span class="muted small">(1 for every 30 worked<%= salaried ? ', counting at least the hours the salary is for' : '' %>)</span></dd>
        <dt>Used this pay run</dt><dd><%= fmtHours(item.sick_hours) %> h</dd>
        <dt>Available afterwards</dt><dd><strong><%= fmtHours(item.sick_balance) %> h</strong></dd>
      </dl>
      <% if (!item.has_w4) { %><p class="hint">No W-4 and DE 4 on file yet: taxes are worked out as single, with no adjustments or allowances. <a href="/staff/<%= item.employee_id %>/withholding">Enter their forms</a>.</p><% } %>
    </section>
  <% } %>
</div>

<% if (breakDays.length) { %>
  <section class="card card-pad">
    <h2>Missed meal and rest breaks</h2>
    <p class="muted small">Each workday with a missed meal break earns an hour's pay, and so does a missed rest break. To change these, fix the hours in <a href="/timesheets">Timesheets</a> and press Recalculate.</p>
    <table class="table compact">
      <thead><tr><th>Workday</th><th class="num">Hours</th><th>Premium</th><th>Why</th></tr></thead>
      <tbody>
        <% for (const d of breakDays) { %>
          <tr><td><%= fmtDay(d.date) %></td><td class="num"><%= fmtHours(d.hours) %></td><td><%= [d.missedMeal && 'Meal', d.missedRest && 'Rest'].filter(Boolean).join(' + ') %></td><td class="small"><%= d.why.join('; ') %></td></tr>
        <% } %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (draft) { %>
  <form method="post" action="/pay/<%= run.id %>/items/<%= item.id %>" class="card form-card narrow">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="back" value="line">
    <h2>Change this pay line</h2>
    <div class="form-grid">
      <label>Adjustment ($) <input type="number" step="0.01" name="adjustment" value="<%= item.adjustment || '' %>" placeholder="0.00"><span class="hint">Added to pay before taxes, e.g. a bonus. Use a minus to correct pay that was too high.</span></label>
      <label>Reason <input name="adjustment_note" value="<%= item.adjustment_note || '' %>" maxlength="120" placeholder="e.g. bonus"></label>
      <% if (w2) { %>
        <label class="field-full">Paid sick leave taken (hours)
          <input type="number" step="0.25" min="0" name="sick_hours" value="<%= item.sick_hours || '' %>" placeholder="0">
          <span class="hint"><%= salaried ? 'It comes off their balance: the salary already pays for the day.' : `Paid at ${money(item.hourly_rate)} an hour.` %> <%= sickLimit ? sickLimit.reason : '' %></span>
        </label>
      <% } %>
      <label>Deduction after taxes ($) <input type="number" step="0.01" min="0" name="deduction" value="<%= item.deduction || '' %>" placeholder="0.00"><span class="hint">Only with the person's written OK (California Labor Code 224), e.g. paying back an advance.</span></label>
      <label>Reason <input name="deduction_note" value="<%= item.deduction_note || '' %>" maxlength="120" placeholder="e.g. advance repayment"></label>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Save</button></div>
  </form>
<% } %>
<%- include('../partials/bottom') %>
