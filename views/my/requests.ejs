<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Shift requests</h1>
    <p class="page-sub">Ask for officers at your sites. The office approves your request, then it's offered to officers: the ones you ask for get first choice. You'll get a notification when it's approved and when each shift is covered.</p>
  </div>
  <div class="page-actions"><a class="btn btn-primary" href="/my/requests/new"><%- icon('plus') %> Request a shift</a></div>
</div>
<div class="card">
  <% if (!requests.length) { %>
    <p class="empty">No requests yet. Press <strong>Request a shift</strong> to ask for officers.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table stack-on-phone">
        <thead><tr><th>When</th><th>Site</th><th class="num">Officers</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% for (const r of requests) { %>
            <tr>
              <td class="nowrap" data-label="When"><%= fmtDay(r.start_at) %> <span class="muted"><%= r.start_at.slice(0, 4) %></span><br><%= fmtRange(r.start_at, r.end_at) %></td>
              <td data-label="Site"><%= r.site_name %><% if (r.notes) { %><div class="muted small"><%= r.notes %></div><% } %>
                <% if (r.asked.length) { %><div class="small">Asked for: <%= r.asked.map((a) => a.name).join(', ') %></div><% } %></td>
              <td class="num" data-label="Officers"><%= r.officers_needed %></td>
              <td data-label="Status">
                <% if (r.status === 'approved') { %>
                  <%- r.covered === r.officers_needed ? badge('Covered', 'green') : badge(`${r.covered} of ${r.officers_needed} covered`, 'blue') %>
                  <% const names = r.shifts.filter((s) => s.name).map((s) => s.name); %>
                  <% if (names.length) { %><div class="small"><%= names.join(', ') %></div><% } %>
                  <% if (r.covered < r.officers_needed) { %><div class="muted small">Being offered to officers</div><% } %>
                <% } else if (r.status === 'declined') { %>
                  <%- badge('Not approved', 'red') %><% if (r.decline_reason) { %><div class="small"><%= r.decline_reason %></div><% } %>
                <% } else { %>
                  <%- badge(STATUS_LABELS[r.status], r.status === 'pending' ? 'amber' : 'gray') %>
                <% } %>
              </td>
              <td class="actions" data-label="">
                <% if (r.status === 'pending') { %>
                  <form method="post" action="/my/requests/<%= r.id %>/cancel" class="inline-form" data-confirm="Cancel this request?">
                    <%- include('../partials/csrf') %>
                    <button type="submit" class="btn btn-sm btn-ghost">Cancel</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/bottom') %>
