<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>My details</h1>
    <p class="page-sub">How the office reaches you. Keep these up to date; the office sees changes straight away.</p>
  </div>
</div>
<%- include('../partials/form-error') %>
<form method="post" action="/my/details" class="card form-card">
  <%- include('../partials/csrf') %>

  <h2>Contact</h2>
  <div class="form-grid">
    <label>Phone <input type="tel" name="phone" value="<%= values.phone || '' %>" required autocomplete="tel"></label>
    <label>Email <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email"></label>
    <label class="field-full">Home address <input name="address" value="<%= values.address || '' %>" autocomplete="street-address"></label>
  </div>

  <h2>Emergency contact</h2>
  <div class="form-grid">
    <label>Name <input name="emergency_contact_name" value="<%= values.emergency_contact_name || '' %>"></label>
    <label>Phone <input type="tel" name="emergency_contact_phone" value="<%= values.emergency_contact_phone || '' %>"></label>
  </div>

  <p class="hint form-note">You sign in with <strong><%= currentUser.email %></strong>. To change that, ask the office. To change your password, go to <a href="/account">My account</a>.</p>
  <div class="form-actions"><button type="submit" class="btn btn-primary">Save</button></div>
</form>
<div id="notifications">
  <%- include('../partials/notifications', { pushWhat: 'Free alerts on this phone, like a text message: reminders 24 hours and 2 hours before each shift, open shifts you can take, changes to your shifts, when time cards are due, and pay day.' }) %>
</div>
<%- include('../partials/bottom') %>
