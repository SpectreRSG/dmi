<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1><%= fmtMonth(month) %></h1>
    <p class="page-sub"><%= heading %></p>
  </div>
  <div class="page-actions"><button type="button" class="btn" data-print>Print</button></div>
</div>

<% if (setup.length) { %>
  <div class="card card-pad setup-steps">
    <h2>Finish setting up</h2>
    <p class="muted small">A one-time job. After this, there's nothing to fill in: your hours are recorded from the schedule.</p>
    <ul>
      <% for (const step of setup) { %><li><a href="<%= step.href %>"><%= step.label %> →</a></li><% } %>
    </ul>
  </div>
<% } %>

<% if (openShifts.length) { %>
  <section class="card card-pad open-shifts" id="open-shifts">
    <h2>Open shifts you can take</h2>
    <p class="muted small">Shifts that need an officer: a call-out, or extra cover a site asked for. The first person to claim one gets it.</p>
    <ul>
      <% for (const o of openShifts) { %>
        <li>
          <span><strong><%= fmtDay(o.start_at) %> · <%= fmtRange(o.start_at, o.end_at) %></strong><br><span class="muted small"><%= o.site_name %> (<%= o.client_name %>)</span></span>
          <a class="btn btn-sm btn-primary" href="/my/open-shifts/<%= o.offer_id %>">See and claim</a>
        </li>
      <% } %>
    </ul>
  </section>
<% } %>

<% if (next) { %>
  <div class="card card-pad next-shift">
    <span class="muted small">Your next shift</span>
    <strong><%= fmtDay(next.start_at) %> · <%= fmtRange(next.start_at, next.end_at) %></strong>
    <span><%= next.site %> (<%= next.client %>)<%= next.address ? ` · ${next.address}` : '' %></span>
  </div>
<% } %>

<div class="toolbar">
  <div class="btn-group">
    <a class="btn" href="/my/schedule?month=<%= prevMonth %>">← <%= fmtMonth(prevMonth).split(' ')[0] %></a>
    <a class="btn <%= month === thisMonth ? 'btn-current' : '' %>" href="/my/schedule">This month</a>
    <a class="btn" href="/my/schedule?month=<%= nextMonth %>"><%= fmtMonth(nextMonth).split(' ')[0] %> →</a>
  </div>
  <p class="muted small month-totals">
    <%= totals.shifts %> shift<%= totals.shifts === 1 ? '' : 's' %> · <%= fmtHours(totals.hours) %> hours
    <% if (!isOfficer && totals.unfilled) { %> · <%- badge(`${totals.unfilled} not yet assigned`, 'amber') %><% } %>
  </p>
</div>

<% if (sites.length) { %>
  <div class="site-cards">
    <% for (const site of sites) { %>
      <div class="card card-pad">
        <h2><%= site.name %></h2>
        <% if (site.address) { %><p class="muted small"><%= site.address %></p><% } %>
        <% if (site.instructions) { %><p class="small pre-line"><%= site.instructions %></p><% } %>
      </div>
    <% } %>
  </div>
<% } %>

<div class="card month-cal" role="table" aria-label="<%= fmtMonth(month) %> calendar">
  <div class="month-row month-head" role="row">
    <% for (const name of ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']) { %><div role="columnheader"><%= name %></div><% } %>
  </div>
  <% for (const week of weeks) { %>
    <div class="month-row" role="row">
      <% for (const day of week) { %>
        <div role="cell" class="month-day <%= day.inMonth ? '' : 'is-other' %> <%= day.date === today ? 'is-today' : '' %>">
          <span class="month-date"><%= Number(day.date.slice(8)) %></span>
          <% const count = day.items.filter((i) => i.status !== 'cancelled' && !['unavailable', 'available'].includes(i.kind)).length; %>
          <% if (count) { %><span class="month-count"><%= count %></span><% } %>
          <% for (const item of day.items) { %>
            <%
              const look = item.kind === 'training' ? 'is-training'
                : item.kind === 'open' ? 'is-claimable'
                : item.kind === 'unavailable' ? 'is-away'
                : item.kind === 'available' ? 'is-free'
                : item.kind === 'request' ? 'is-requested'
                : item.status === 'cancelled' ? 'is-cancelled'
                : !item.guard ? (item.offered ? 'is-claimable' : 'is-open') : '';
            %>
            <<%= item.kind === 'open' ? `a href="/my/open-shifts/${item.offerId}"` : 'div' %> class="cal-item <%= look %>">
              <span class="cal-time"><%= item.allDay ? 'All day' : fmtRange(item.start_at, item.end_at) %></span>
              <span class="cal-what">
                <% if (item.kind === 'training') { %><%= item.course %> training
                <% } else if (item.kind === 'open') { %>Open: <%= item.site %>
                <% } else if (item.kind === 'unavailable') { %>Can't work
                <% } else if (item.kind === 'available') { %>Available
                <% } else if (item.kind === 'request') { %>Requested<%= item.count > 1 ? ` ×${item.count}` : '' %>: <%= item.site %>
                <% } else if (isOfficer) { %><%= item.site %>
                <% } else { %><%= item.guard || (item.offered ? 'Open shift' : 'Not yet assigned') %><% } %>
              </span>
            </<%= item.kind === 'open' ? 'a' : 'div' %>>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<ul class="cal-legend" aria-label="Colour key">
  <% if (isOfficer) { %>
    <li><span class="cal-key"></span>Your shift</li>
    <li><span class="cal-key is-claimable"></span>Open shift you can claim</li>
    <li><span class="cal-key is-training"></span>Training</li>
    <li><span class="cal-key is-away"></span>You can't work</li>
    <li><span class="cal-key is-free"></span>You're available</li>
  <% } else { %>
    <li><span class="cal-key"></span>Officer assigned</li>
    <li><span class="cal-key is-claimable"></span>Open: offered to officers</li>
    <li><span class="cal-key is-open"></span>Not yet assigned</li>
    <li><span class="cal-key is-requested"></span>Your request, waiting for approval</li>
  <% } %>
</ul>

<h2 class="section-title">Details</h2>
<% if (!monthItems.length) { %>
  <div class="card"><p class="empty">Nothing scheduled in <%= fmtMonth(month) %>.</p></div>
<% } %>
<% let lastDate = null; %>
<% if (monthItems.length) { %>
<div class="card agenda-card">
  <ul class="agenda">
    <% for (const item of monthItems) { const date = item.start_at.slice(0, 10); %>
      <li class="agenda-item <%= item.status === 'cancelled' ? 'is-cancelled' : '' %> <%= date < today ? 'is-past' : '' %>">
        <div class="agenda-time"><% if (date !== lastDate) { %><span class="agenda-day"><%= fmtDay(date) %></span><% } lastDate = date; %><%= fmtRange(item.start_at, item.end_at) %></div>
        <div class="agenda-body">
          <% if (item.kind === 'training') { %>
            <strong><%= item.course %> training</strong> <%- badge('Training', 'blue') %>
            <% if (item.location) { %><div class="muted small"><%= item.location %></div><% } %>
          <% } else if (item.kind === 'open') { %>
            <strong>Open shift: <%= item.site %></strong> <span class="muted">· <%= item.client %></span>
            <div><a class="btn btn-sm btn-primary" href="/my/open-shifts/<%= item.offerId %>">See and claim</a></div>
          <% } else if (item.kind === 'unavailable' || item.kind === 'available') { %>
            <strong><%= item.kind === 'unavailable' ? "You can't work" : "You're available for extra shifts" %></strong><%= item.note ? ` · ${item.note}` : '' %>
            <div class="small"><a href="/my/availability">Change your availability</a></div>
          <% } else if (item.kind === 'request') { %>
            <strong>Requested: <%= item.count %> officer<%= item.count === 1 ? '' : 's' %></strong> <span class="muted">· <%= item.site %></span>
            <%- badge('Waiting for the office to approve', 'gray') %>
          <% } else if (isOfficer) { %>
            <strong><%= item.site %></strong> <span class="muted">· <%= item.client %></span>
            <% if (item.status === 'cancelled') { %><%- badge('Cancelled', 'gray') %><% } %>
            <% if (item.address) { %><div class="muted small"><%= item.address %></div><% } %>
            <% if (item.notes) { %><div class="small pre-line"><%= item.notes %></div><% } %>
            <% if (item.instructions) { %>
              <details class="small"><summary>Site instructions</summary><p class="pre-line"><%= item.instructions %></p></details>
            <% } %>
            <% if (item.canCallOut) { %><a class="small callout-link" href="/my/shifts/<%= item.id %>/call-out">I can't make it</a><% } %>
          <% } else { %>
            <% if (item.guard) { %><strong><%= item.guard %></strong><% } else if (item.offered) { %><%- badge('Open: offered to officers', 'green') %><% } else { %><%- badge('Not yet assigned', 'amber') %><% } %>
            <span class="muted">· <%= item.site %></span>
            <% if (item.status === 'cancelled') { %><%- badge('Cancelled', 'gray') %><% } %>
          <% } %>
        </div>
      </li>
    <% } %>
  </ul>
</div>
<% } %>
<p class="muted small center-note">Schedules can change, so check back before each shift.</p>
<%- include('../partials/bottom') %>
