<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/schedule">← Schedule</a></p>
    <h1>Availability</h1>
    <p class="page-sub">What officers told us for <%= fmtDate(from) %> – <%= fmtDate(to) %>. "Find cover" and open-shift offers skip people who can't work, and ask people who are available first.</p>
  </div>
</div>
<div class="card">
  <% if (!people.length) { %>
    <p class="empty">Nobody has said anything about their availability for the next four weeks. Officers add it under <strong>My availability</strong>.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table stack-on-phone">
        <thead><tr><th>Staff member</th><th>Availability</th></tr></thead>
        <tbody>
          <% for (const p of people) { %>
            <tr>
              <td data-label="Staff member"><a href="/staff/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a></td>
              <td data-label="Availability">
                <% for (const e of p.entries) { %>
                  <div><%- e.kind === 'unavailable' ? badge("Can't work", 'gray') : badge('Available', 'green') %> <%= e.label %><% if (e.note) { %> <span class="muted">· <%= e.note %></span><% } %></div>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/bottom') %>
