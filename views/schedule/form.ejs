<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/schedule?week=<%= startOfWeek(shift.date || todayStr()) %>">← Schedule</a></p>
    <h1><%= title %> <% if (shift.id) { %><%- statusBadge(shift.status) %><% } %></h1>
  </div>
</div>
<% if (!sites.length) { %>
  <div class="flash flash-warning">You need at least one site before you can add shifts. <a href="/clients">Add a client and site first</a>.</div>
<% } %>
<%- include('../partials/form-error') %>
<form method="post" action="<%= shift.id ? `/schedule/${shift.id}` : '/schedule' %>" class="card form-card">
  <%- include('../partials/csrf') %>
  <div class="form-grid">
    <label>Site
      <select name="site_id" required>
        <option value="">Choose a site…</option>
        <% for (const s of sites) { %><option value="<%= s.id %>" <%= shift.site_id === s.id ? 'selected' : '' %>><%= s.client_name %> – <%= s.name %></option><% } %>
      </select>
    </label>
    <label>Staff member
      <select name="employee_id">
        <option value="">— Unfilled (assign later) —</option>
        <% for (const e of staff) { %><option value="<%= e.id %>" <%= shift.employee_id === e.id ? 'selected' : '' %>><%= e.first_name %> <%= e.last_name %></option><% } %>
      </select>
    </label>
    <label>Date <input type="date" name="date" value="<%= shift.date || '' %>" required></label>
    <div class="field-pair">
      <label>Start time <input type="time" name="start_time" value="<%= shift.start_time || '' %>" required></label>
      <label>End time <input type="time" name="end_time" value="<%= shift.end_time || '' %>" required></label>
    </div>
    <p class="hint field-full">If the end time is earlier than the start time, the shift finishes the next day (for example, a night shift from 22:00 to 06:00).</p>
    <label>Unpaid break (minutes) <input type="number" name="break_minutes" min="0" max="600" step="1" value="<%= shift.break_minutes ?? 0 %>"></label>
    <% if (shift.id) { %>
      <label>Status
        <select name="status">
          <% for (const st of ['scheduled', 'completed', 'cancelled']) { %><option value="<%= st %>" <%= shift.status === st ? 'selected' : '' %>><%= capitalize(st) %></option><% } %>
        </select>
      </label>
    <% } else { %>
      <fieldset class="field-full repeat-box">
        <legend>Repeat (optional)</legend>
        <div class="weekday-picker">
          <% WEEKDAYS.forEach((name, i) => { %>
            <label class="day-chip"><input type="checkbox" name="repeat_days" value="<%= i %>" <%= (shift.repeat_days || []).includes(i) ? 'checked' : '' %>><span><%= name %></span></label>
          <% }) %>
        </div>
        <label class="repeat-until">Repeat until <input type="date" name="repeat_until" value="<%= shift.repeat_until || '' %>"></label>
        <p class="hint">The first shift is on the date above. It then repeats on every ticked day until this date. Days when the person is already booked are skipped.</p>
      </fieldset>
    <% } %>
    <label class="field-full">Notes <textarea name="notes" rows="2" placeholder="Anything the guard should know for this shift"><%= shift.notes || '' %></textarea></label>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save shift</button>
    <a class="btn btn-ghost" href="/schedule?week=<%= startOfWeek(shift.date || todayStr()) %>">Cancel</a>
  </div>
</form>

<% if (shift.id) { %>
  <div class="card form-card">
    <h2>Hours</h2>
    <% const t = shift.time_entry; %>
    <% if (t && t.source === 'schedule') { %>
      <p>Recorded from the schedule when the shift ended<%= t.status === 'rejected' ? ', then rejected in timesheets' : '' %>. <a href="/timesheets?status=all&employee=<%= shift.employee_id %>">See them in timesheets</a></p>
      <p class="muted small"><%= t.pay_run_status === 'finalized' ? 'These hours have been paid, so the shift can no longer change (except its notes).' : "If the officer's real hours were different, change the times above and save: the hours follow." %></p>
    <% } else if (t) { %>
      <p>This shift is in <a href="/timesheets?status=all&employee=<%= shift.employee_id %>">timesheets</a>.</p>
    <% } else { %>
      <p class="muted">When this shift ends, its hours are recorded and approved by themselves, ready for pay day. If the officer's real hours were different, change the times above (before the pay run is finalized) and the hours follow.</p>
    <% } %>
  </div>
  <% if (shift.upcoming || shift.offer || (shift.callouts && shift.callouts.length)) { %>
  <div class="card form-card">
    <h2>Call-outs and cover</h2>
    <% for (const c of shift.callouts || []) { %>
      <p class="small"><%- badge('Called out', 'amber') %> <%= c.first_name %> <%= c.last_name %>, <%= c.hours_notice %> h before the start<%= c.reason ? ` – "${c.reason}"` : '' %></p>
    <% } %>
    <% const o = shift.offer; %>
    <% if (o && o.status === 'open') { %>
      <p><%- badge('Offered to officers', 'blue') %> Told <%= o.told %> officer<%= o.told === 1 ? '' : 's' %><%= o.waiting ? `, ${o.waiting} more at ${fmtTime(o.next_wave_at)}` : '' %>. The first to claim it gets it.
        <%= o.escalated_at ? 'Nobody has claimed it yet.' : `If nobody has by ${fmtTime(o.escalate_at)}, the office is told.` %></p>
      <form method="post" action="/schedule/<%= shift.id %>/withdraw-offer" class="inline-form">
        <%- include('../partials/csrf') %>
        <button type="submit" class="btn btn-sm btn-ghost">Withdraw the offer</button>
      </form>
    <% } else if (o && o.status === 'filled') { %>
      <p><%- badge('Covered', 'green') %> <%= o.filled_first %> <%= o.filled_last %> claimed it at <%= fmtTime(o.filled_at) %>.</p>
    <% } %>
    <% if (shift.upcoming && shift.employee_id) { %>
      <p class="muted small">Officer phoned in and can't make it? This takes them off and offers the shift to the officers who are free, rested and qualified. Regulars at this site hear first.</p>
      <form method="post" action="/schedule/<%= shift.id %>/call-out" class="inline-form" data-confirm="Take <%= shift.first_name %> off this shift and offer it to other officers?">
        <%- include('../partials/csrf') %>
        <label class="inline">Reason <input name="reason" maxlength="200" placeholder="optional"></label>
        <button type="submit" class="btn">Note call-out and offer it</button>
      </form>
    <% } else if (shift.upcoming && !shift.employee_id && !(o && o.status === 'open')) { %>
      <p class="muted small">Let officers claim this shift themselves: it's offered to everyone who is free, rested and qualified, and the first to claim it gets it.</p>
      <form method="post" action="/schedule/<%= shift.id %>/offer" class="inline-form">
        <%- include('../partials/csrf') %>
        <button type="submit" class="btn">Offer to officers</button>
      </form>
    <% } %>
  </div>
  <% } %>
  <details class="danger-zone">
    <summary>Delete this shift</summary>
    <p>If it simply isn't happening any more, you can set its status to <strong>Cancelled</strong> instead, which keeps a record.</p>
    <form method="post" action="/schedule/<%= shift.id %>/delete" data-confirm="Delete this shift?">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn btn-danger">Delete shift</button>
    </form>
  </details>
<% } %>
<%- include('../partials/bottom') %>
