<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Confirm it's you</h1>
    <p class="page-sub"><%= reason %></p>
  </div>
</div>
<%- include('../partials/form-error') %>
<form method="post" action="/account/confirm" class="card form-card narrow">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="next" value="<%= next %>">
  <label>Code from your authenticator app (or a backup code)
    <input name="code" required autofocus inputmode="numeric" autocomplete="one-time-code" maxlength="12" placeholder="123 456" class="code-input">
  </label>
  <div class="form-actions"><button type="submit" class="btn btn-primary">Continue</button></div>
</form>
<%- include('../partials/bottom') %>
