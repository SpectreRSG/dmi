<%- include('../partials/top') %>
<div class="auth-card">
  <div class="auth-logo"><%- icon('shield') %></div>
  <h1><%= settings.company_name %> Admin</h1>
  <p class="muted">Sign in to continue.</p>
  <%- include('../partials/form-error') %>
  <form method="post" action="/login" class="stack">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email
      <input type="email" name="email" value="<%= email %>" required autofocus autocomplete="username">
    </label>
    <label>Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-primary btn-block">Sign in</button>
  </form>
  <p class="auth-footer">Officer or client? <a href="/portal">View your schedule →</a><br>Security officer? <a href="/timesheet/">Fill in your timesheet →</a></p>
</div>
<%- include('../partials/bottom') %>
