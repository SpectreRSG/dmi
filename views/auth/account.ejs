<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>My account</h1>
    <p class="page-sub"><%= currentUser.name %> · <%= currentUser.email %> · <%= ROLE_NAMES[currentUser.role] %></p>
  </div>
  <div class="page-actions">
    <form method="post" action="/logout" class="inline-form">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn"><%- icon('logout') %> Sign out</button>
    </form>
  </div>
</div>

<section class="card card-pad narrow" id="two-step">
  <h2>Two-step sign-in</h2>
  <% if (hasSecondStep) { %>
    <p><%- badge('On', 'green') %>
      <% if (currentUser.totp_enabled_at && passkeys.length) { %>You use a passkey or a code from your authenticator app (on since <%= fmtDate(currentUser.totp_enabled_at.slice(0, 10)) %>).
      <% } else if (currentUser.totp_enabled_at) { %>Since <%= fmtDate(currentUser.totp_enabled_at.slice(0, 10)) %>. After your password, you type a code from your authenticator app.
      <% } else { %>You sign in with a passkey (below).<% } %>
    </p>
    <p class="muted small">Backup codes left: <strong><%= codesLeft %></strong> of 10.<%= codesLeft < 4 ? ' Make new ones soon.' : '' %> Each one gets you in once if you don't have your phone.</p>
    <div class="btn-row">
      <form method="post" action="/account/two-step/backup-codes" class="inline-form" data-confirm="Make new backup codes? Your old ones will stop working.">
        <%- include('../partials/csrf') %>
        <button type="submit" class="btn btn-sm">Make new backup codes</button>
      </form>
      <% if (!currentUser.totp_enabled_at) { %>
        <a class="btn btn-sm" href="/account/two-step">Also add an authenticator app</a>
      <% } %>
      <% if (!twoStepRequired) { %>
        <form method="post" action="/account/two-step/off" class="inline-form" data-confirm="Turn off two-step sign-in? Your passkeys will be removed too, and your password alone will sign you in.">
          <%- include('../partials/csrf') %>
          <button type="submit" class="btn btn-sm btn-ghost">Turn off</button>
        </form>
      <% } %>
    </div>
    <p class="muted small">New phone? Passkeys saved in iCloud Keychain (or Google Password Manager) move to it by themselves.<% if (currentUser.totp_enabled_at) { %> For the authenticator app, ask the office to reset your two-step sign-in, then set it up again on the new phone.<% } %></p>
  <% } else { %>
    <p><%- badge('Off', 'amber') %> Protect your account with a passkey (Face ID or Touch ID) or a code from your phone, as well as your password.</p>
    <a class="btn btn-primary btn-sm" href="/account/two-step">Set up two-step sign-in</a>
  <% } %>
</section>

<section class="card card-pad narrow" id="passkeys">
  <h2>Passkeys</h2>
  <p class="muted small">Sign in with Face ID, Touch ID or your phone's screen lock, with no password or code to type. On iPhone, iPad and Mac they're kept in iCloud Keychain, so one passkey works on all your Apple devices.</p>
  <% if (passkeys.length) { %>
    <ul class="device-list">
      <% for (const p of passkeys) { %>
        <li>
          <span><strong><%= p.name || 'Passkey' %></strong><br><span class="muted small">Added <%= fmtDate(p.created_at.slice(0, 10)) %><%= p.last_used_at ? `, last used ${fmtDateTime(p.last_used_at.replace(' ', 'T').slice(0, 16))}` : ', not used yet' %></span></span>
          <form method="post" action="/account/passkeys/<%= p.id %>/delete" class="inline-form" data-confirm="Remove this passkey? It will stop working for this site.">
            <%- include('../partials/csrf') %>
            <button type="submit" class="btn btn-sm btn-ghost">Remove</button>
          </form>
        </li>
      <% } %>
    </ul>
  <% } %>
  <div class="passkey-choice" data-passkey="register">
    <button type="button" class="btn btn-sm<%= passkeys.length ? '' : ' btn-primary' %>" data-passkey-start><%- icon('passkey') %> Add a passkey on this device</button>
    <p class="hint" data-passkey-unsupported hidden>This browser can't make passkeys. Try Safari on an iPhone or Mac, or Chrome or Edge.</p>
  </div>
  <div class="flash flash-error" role="alert" data-passkey-error hidden></div>
</section>

<section class="card card-pad narrow">
  <h2>Where you're signed in</h2>
  <ul class="device-list">
    <% for (const d of devices) { %>
      <li><span><strong><%= d.device %></strong><%= d.current ? ' (this device)' : '' %></span><span class="muted small"><%= d.since ? `since ${fmtDateTime(d.since)}` : '' %></span></li>
    <% } %>
  </ul>
  <% if (devices.length > 1) { %>
    <form method="post" action="/account/sign-out-others" class="inline-form" data-confirm="Sign out on every other phone and computer?">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn btn-sm">Sign out everywhere else</button>
    </form>
  <% } %>
  <% if (history.length) { %>
    <h3 class="small-heading">Recent sign-ins</h3>
    <ul class="plain-list small">
      <% for (const h of history) { %><li><%= fmtDateTime(h.created_at.replace(' ', 'T').slice(0, 16)) %>: <%= h.action %></li><% } %>
    </ul>
    <p class="muted small">Don't recognise one? Change your password below and tell the office.</p>
  <% } %>
</section>

<div class="card form-card narrow">
  <h2>Change password</h2>
  <%- include('../partials/form-error') %>
  <form method="post" action="/account/password" class="stack">
    <%- include('../partials/csrf') %>
    <label>Current password
      <input type="password" name="current" required autocomplete="current-password">
    </label>
    <label>New password
      <input type="password" name="password" required minlength="10" autocomplete="new-password">
      <span class="hint">At least 10 characters. A few unrelated words work well, like "harbor lamp violin 42". Changing it signs you out on your other devices.</span>
    </label>
    <label>Type the new password again
      <input type="password" name="confirm" required minlength="10" autocomplete="new-password">
    </label>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Change password</button></div>
  </form>
</div>
<div class="narrow">
  <%- include('../partials/notifications', { pushWhat: ['admin', 'manager'].includes(currentUser.role) ? 'Free alerts on this phone or computer, like a text message: call-outs, open shifts nobody has claimed, and sign-ins to your account.' : currentUser.role === 'officer' ? 'Free alerts on this phone or computer, like a text message: open shifts, schedule changes, pay day, and sign-ins to your account.' : null }) %>
</div>
<%- include('../partials/bottom') %>
