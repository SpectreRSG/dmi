<%- include('../partials/top') %>
<div class="auth-card">
  <div class="auth-logo"><%- icon('key') %></div>
  <h1>Two-step sign-in</h1>
  <p class="muted">Open your authenticator app and type the 6-digit code for <%= settings.company_name %>.</p>
  <%- include('../partials/form-error') %>
  <form method="post" action="/login/verify" class="stack">
    <%- include('../partials/csrf') %>
    <label>Code
      <input name="code" required autofocus inputmode="numeric" autocomplete="one-time-code" maxlength="12" placeholder="123 456" class="code-input">
    </label>
    <label class="check"><input type="checkbox" name="remember" value="1"> Remember this device for <%= trustDays %> days (only on your own phone or computer)</label>
    <button type="submit" class="btn btn-primary btn-block">Sign in</button>
  </form>
  <p class="auth-footer">No phone with you? Type one of your backup codes instead (like <code>k7wq-3mzp</code>).<br>Lost your phone and your backup codes? Ask the office to reset your two-step sign-in.<br><a href="/login">← Start again</a></p>
</div>
<%- include('../partials/bottom') %>
