<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/training/courses">← Courses</a></p>
    <h1><%= title %></h1>
  </div>
</div>
<%- include('../partials/form-error') %>
<form method="post" action="<%= course.id ? `/training/courses/${course.id}` : '/training/courses' %>" class="card form-card narrow">
  <%- include('../partials/csrf') %>
  <div class="form-grid">
    <label class="field-full">Course name <input name="name" value="<%= course.name || '' %>" required placeholder="e.g. First Aid & CPR"></label>
    <label class="field-full">Description <textarea name="description" rows="2"><%= course.description || '' %></textarea></label>
    <label>Valid for (months)
      <input type="number" name="validity_months" min="1" step="1" value="<%= course.validity_months ?? '' %>">
      <span class="hint">Leave empty if it never expires. Used to fill in expiry dates automatically.</span>
    </label>
    <div class="stack">
      <label class="check"><input type="checkbox" name="required" value="1" <%= course.required ? 'checked' : '' %>> Required for all staff</label>
      <label class="check"><input type="checkbox" name="active" value="1" <%= course.active ? 'checked' : '' %>> Active</label>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-ghost" href="/training/courses">Cancel</a>
  </div>
</form>
<% if (course.id) { %>
  <details class="danger-zone">
    <summary>Delete this course</summary>
    <p>Only possible if nobody has a record or session for it. Otherwise untick <strong>Active</strong>.</p>
    <form method="post" action="/training/courses/<%= course.id %>/delete" data-confirm="Delete this course?">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn btn-danger">Delete course</button>
    </form>
  </details>
<% } %>
<%- include('../partials/bottom') %>
