<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${title} · ` : '' %><%= locals.settings ? settings.company_name : '' %> Admin</title>
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/icons/favicon-64.png" sizes="64x64" type="image/png">
  <!-- So the site can be added to a phone's home screen like an app (needed for notifications on iPhones). -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="DMI">
  <meta name="theme-color" content="#0f1b2d">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body<% if (locals.currentUser) { %> data-user="<%= currentUser.id %>"<% } %>>
<% if (locals.currentUser) { %>
<div class="layout">
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="<%= homeFor(currentUser) %>"><img src="/img/logo.png" alt="Direct Measures Inc" width="640" height="240"></a>
    <nav class="nav" aria-label="Main">
      <% for (const item of NAV) { if (!item.roles.includes(currentUser.role)) continue; %>
        <a href="<%= item.href %>" class="<%= [item.href, ...(item.also || [])].some((href) => isActive(currentPath, href)) ? 'active' : '' %>"><%- icon(item.icon) %><span><%= item.label %></span><% if (item.badge === 'messages' && locals.unreadMessages) { %><span class="nav-count" aria-label="<%= unreadMessages %> unread"><%= unreadMessages %></span><% } %></a>
      <% } %>
      <% if (locals.isAdmin) { %>
        <div class="nav-heading">Admin</div>
        <% for (const item of ADMIN_NAV) { %>
          <a href="<%= item.href %>" class="<%= isActive(currentPath, item.href) ? 'active' : '' %>"><%- icon(item.icon) %><span><%= item.label %></span></a>
        <% } %>
      <% } %>
    </nav>
    <div class="sidebar-user">
      <a href="/account" class="<%= isActive(currentPath, '/account') ? 'active' : '' %>">
        <%- icon('user') %>
        <span><%= currentUser.name %><small>My account · <%= ROLE_NAMES[currentUser.role] %></small></span>
      </a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <button type="submit" class="nav-button"><%- icon('logout') %><span>Sign out</span></button>
      </form>
    </div>
  </aside>
  <div class="main">
    <header class="mobile-bar">
      <button type="button" class="icon-button" data-nav-toggle aria-controls="sidebar" aria-expanded="false"><%- icon('menu') %><span class="sr-only">Menu</span></button>
      <a href="<%= homeFor(currentUser) %>" class="mobile-brand"><img src="/img/logo-mark.png" alt="Direct Measures Inc" width="288" height="160"></a>
      <% if (locals.unreadMessages !== undefined) { const chatHref = currentUser.role === 'admin' ? '/chat' : '/my/chat'; %>
        <a href="<%= chatHref %>" class="mobile-chat<%= isActive(currentPath, chatHref) ? ' active' : '' %>" title="Messages"><%- icon('chat') %><% if (unreadMessages) { %><span class="nav-count"><%= unreadMessages %></span><% } %><span class="sr-only">Messages</span></a>
      <% } %>
      <a href="/account" class="mobile-account<%= isActive(currentPath, '/account') ? ' active' : '' %>" title="My account"><%- icon('user') %><span class="sr-only">My account</span></a>
      <form method="post" action="/logout" class="mobile-signout">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <button type="submit"><%- icon('logout') %><span>Sign out</span></button>
      </form>
    </header>
    <main class="content">
      <%- include('flash') %>
<% } else { %>
<main class="auth-page">
  <a href="/login" class="auth-brand"><img src="/img/logo.png" alt="Direct Measures Inc" width="640" height="240"></a>
  <%- include('flash') %>
<% } %>
