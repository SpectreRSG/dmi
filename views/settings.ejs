<%- include('partials/top') %>
<div class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="page-sub">Company-wide options.</p>
  </div>
</div>
<%- include('partials/form-error') %>
<form method="post" action="/settings" class="card form-card narrow">
  <%- include('partials/csrf') %>
  <h2>Company</h2>
  <div class="form-grid">
    <label>Company name <input name="company_name" value="<%= values.company_name || '' %>" required></label>
    <label>Currency symbol <input name="currency_symbol" value="<%= values.currency_symbol %>" maxlength="5"></label>
    <label class="field-full">Time zone
      <select name="timezone">
        <% for (const [zone, label] of TIMEZONES) { %><option value="<%= zone %>" <%= values.timezone === zone ? 'selected' : '' %>><%= label %></option><% } %>
      </select>
      <span class="hint">Decides what "today" and "now" mean everywhere in the app.</span>
    </label>
  </div>
  <h2>Overtime</h2>
  <div class="form-grid">
    <label>Hours per week before overtime
      <input type="number" name="overtime_weekly_hours" min="0" max="168" step="0.5" value="<%= values.overtime_weekly_hours %>">
      <span class="hint">Weeks run Monday to Sunday. Use 0 to turn overtime off.</span>
    </label>
    <label>Overtime pay multiplier
      <input type="number" name="overtime_multiplier" min="1" max="5" step="0.05" value="<%= values.overtime_multiplier %>">
      <span class="hint">1.5 = "time and a half", 2 = "double time".</span>
    </label>
  </div>
  <h2>Scheduling</h2>
  <div class="form-grid">
    <label>Minimum rest between shifts (hours)
      <input type="number" name="min_rest_hours" min="0" max="24" step="0.5" value="<%= values.min_rest_hours %>">
      <span class="hint">The conflict checker warns when someone has less time off than this between two shifts.</span>
    </label>
  </div>
  <h2>Reminders</h2>
  <div class="form-grid">
    <label>Warn this many days before expiry
      <input type="number" name="expiry_warning_days" min="0" max="365" step="1" value="<%= values.expiry_warning_days %>">
      <span class="hint">For licenses, training certificates and contracts.</span>
    </label>
  </div>
  <h2>1099 forms (the "payer")</h2>
  <p class="hint">Exactly as the company is registered with the IRS. These go on every 1099-NEC.</p>
  <div class="form-grid">
    <label class="field-full">Legal business name <input name="payer_name" value="<%= values.payer_name || '' %>" maxlength="120"></label>
    <label>EIN (employer identification number) <input name="payer_ein" value="<%= values.payer_ein || '' %>" placeholder="12-3456789" maxlength="12"></label>
    <label>Phone <input type="tel" name="payer_phone" value="<%= values.payer_phone || '' %>" maxlength="30"></label>
    <label class="field-full">Street address <input name="payer_address" value="<%= values.payer_address || '' %>" maxlength="120"></label>
    <label>City <input name="payer_city" value="<%= values.payer_city || '' %>" maxlength="60"></label>
    <div class="field-pair">
      <label>State <input name="payer_state" value="<%= values.payer_state || '' %>" maxlength="2" placeholder="CA"></label>
      <label>ZIP <input name="payer_zip" value="<%= values.payer_zip || '' %>" maxlength="10"></label>
    </div>
    <label>State payer number (optional) <input name="payer_state_id" value="<%= values.payer_state_id || '' %>" maxlength="30"><span class="hint">For box 6, if your state gave you one.</span></label>
  </div>
  <div class="form-actions"><button type="submit" class="btn btn-primary">Save settings</button></div>
</form>
<%- include('partials/bottom') %>
