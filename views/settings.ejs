<%- include('partials/top') %>
<div class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="page-sub">Company-wide options.</p>
  </div>
</div>
<%- include('partials/form-error') %>
<form method="post" action="/settings" class="card form-card narrow">
  <%- include('partials/csrf') %>
  <h2>Company</h2>
  <div class="form-grid">
    <label>Company name <input name="company_name" value="<%= values.company_name || '' %>" required></label>
    <label>Currency symbol <input name="currency_symbol" value="<%= values.currency_symbol %>" maxlength="5"></label>
    <label class="field-full">Time zone
      <select name="timezone">
        <% for (const [zone, label] of TIMEZONES) { %><option value="<%= zone %>" <%= values.timezone === zone ? 'selected' : '' %>><%= label %></option><% } %>
      </select>
      <span class="hint">Decides what "today" and "now" mean everywhere in the app.</span>
    </label>
  </div>
  <h2>Overtime</h2>
  <div class="form-grid">
    <label>Daily overtime
      <select name="daily_overtime">
        <option value="california" <%= values.daily_overtime === 'california' ? 'selected' : '' %>>California (daily and weekly)</option>
        <option value="off" <%= values.daily_overtime === 'off' ? 'selected' : '' %>>Weekly only</option>
      </select>
      <span class="hint">California: hours over 8 in a workday pay the overtime rate, hours over 12 pay double. Working all 7 days of a week: the 7th day’s first 8 hours are overtime, the rest double. The weekly limit below still applies to the other hours.</span>
    </label>
    <label>Each workday starts at
      <input type="time" name="workday_start" value="<%= values.workday_start %>" required>
      <span class="hint">A workday is the 24 hours from this time. 06:00 counts a 6 PM–6 AM night shift as one workday. Pick it once and keep it: California expects the same workday every day.</span>
    </label>
    <label>Hours per week before overtime
      <input type="number" name="overtime_weekly_hours" min="0" max="168" step="0.5" value="<%= values.overtime_weekly_hours %>">
      <span class="hint">Weeks run Monday to Sunday. Use 0 for no weekly overtime.</span>
    </label>
    <label>Overtime pay multiplier
      <input type="number" name="overtime_multiplier" min="1" max="5" step="0.05" value="<%= values.overtime_multiplier %>">
      <span class="hint">1.5 = "time and a half", 2 = "double time".</span>
    </label>
  </div>
  <h2>Payroll (W-2 employees)</h2>
  <p class="hint">Used to work out tax withholding and the company's own payroll taxes. The tax rates themselves are under <a href="/pay/taxes">Pay → Tax rates</a>.</p>
  <div class="form-grid">
    <label>People are paid
      <select name="pay_frequency">
        <% for (const [key, f] of Object.entries(PAY_FREQUENCIES)) { %><option value="<%= key %>" <%= values.pay_frequency === key ? 'selected' : '' %>><%= f.label %></option><% } %>
      </select>
      <span class="hint">Withholding is worked out for this many paydays a year. Keep your pay runs the same length.</span>
    </label>
    <label>California UI rate (%)
      <input type="number" name="ca_ui_rate" min="0" max="10" step="0.01" value="<%= values.ca_ui_rate %>">
      <span class="hint">Unemployment insurance, on each employee's first $7,000 a year. The EDD mails your rate each December (3.4% for new employers).</span>
    </label>
    <label>California ETT rate (%)
      <input type="number" name="ca_ett_rate" min="0" max="1" step="0.01" value="<%= values.ca_ett_rate %>">
      <span class="hint">Employment training tax, on the same first $7,000. Usually 0.1%.</span>
    </label>
    <label>FUTA credit reduction (%)
      <input type="number" name="futa_credit_reduction" min="0" max="6" step="0.1" value="<%= values.futa_credit_reduction %>">
      <span class="hint">Extra federal unemployment tax for California employers, on the first $7,000. Projected at 1.5% for 2026; the IRS confirms it each November.</span>
    </label>
  </div>
  <h2>Scheduling</h2>
  <div class="form-grid">
    <label>Minimum rest between shifts (hours)
      <input type="number" name="min_rest_hours" min="0" max="24" step="0.5" value="<%= values.min_rest_hours %>">
      <span class="hint">The conflict checker warns when someone has less time off than this between two shifts.</span>
    </label>
  </div>
  <h2>Reminders</h2>
  <div class="form-grid">
    <label>Warn this many days before expiry
      <input type="number" name="expiry_warning_days" min="0" max="365" step="1" value="<%= values.expiry_warning_days %>">
      <span class="hint">For licenses, training certificates and contracts.</span>
    </label>
  </div>
  <h2>Sign-in security</h2>
  <div class="form-grid">
    <label>Two-step sign-in is required for
      <select name="two_step_required_for">
        <option value="everyone" <%= values.two_step_required_for !== 'office' ? 'selected' : '' %>>Everyone (recommended)</option>
        <option value="office" <%= values.two_step_required_for === 'office' ? 'selected' : '' %>>Office staff only (admins and managers)</option>
      </select>
      <span class="hint">People sign in with a passkey (Face ID, Touch ID or their phone's screen lock), or type a code from an authenticator app after their password. Admins and managers always need it. Officers and clients can still turn it on themselves.</span>
    </label>
  </div>
  <h2>Company tax details</h2>
  <p class="hint">Exactly as the company is registered with the IRS and the EDD. These go on every pay stub, 1099-NEC and W-2.</p>
  <div class="form-grid">
    <label class="field-full">Legal business name <input name="payer_name" value="<%= values.payer_name || '' %>" maxlength="120"></label>
    <label>EIN (employer identification number) <input name="payer_ein" value="<%= values.payer_ein || '' %>" placeholder="12-3456789" maxlength="12"></label>
    <label>Phone <input type="tel" name="payer_phone" value="<%= values.payer_phone || '' %>" maxlength="30"></label>
    <label class="field-full">Street address <input name="payer_address" value="<%= values.payer_address || '' %>" maxlength="120"></label>
    <label>City <input name="payer_city" value="<%= values.payer_city || '' %>" maxlength="60"></label>
    <div class="field-pair">
      <label>State <input name="payer_state" value="<%= values.payer_state || '' %>" maxlength="2" placeholder="CA"></label>
      <label>ZIP <input name="payer_zip" value="<%= values.payer_zip || '' %>" maxlength="10"></label>
    </div>
    <label>California employer account number <input name="payer_state_id" value="<%= values.payer_state_id || '' %>" maxlength="30"><span class="hint">The 8-digit payroll tax account number from the EDD. It goes in box 6 of 1099s and box 15 of W-2s.</span></label>
  </div>
  <h2>Incident reports</h2>
  <div class="form-grid">
    <label>PPO license number <input name="ppo_license" value="<%= values.ppo_license || '' %>" maxlength="30"><span class="hint">Your private patrol operator license. It's filled in on officers' incident reports, with the legal name, address and phone above.</span></label>
  </div>
  <div class="form-actions"><button type="submit" class="btn btn-primary">Save settings</button></div>
</form>
<%- include('partials/bottom') %>
