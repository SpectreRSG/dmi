<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Clients &amp; sites</h1>
    <p class="page-sub">Your customers, and the places your guards work for them.</p>
  </div>
  <div class="page-actions"><a class="btn btn-primary" href="/clients/new"><%- icon('plus') %> Add client</a></div>
</div>

<form class="filters" method="get" action="/clients">
  <input type="search" name="q" value="<%= q %>" placeholder="Search clients…" aria-label="Search">
  <button class="btn" type="submit">Search</button>
</form>

<div class="card">
  <% if (!clients.length) { %>
    <p class="empty">No clients yet. <a href="/clients/new">Add your first client</a>.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Client</th><th>Contact</th><th>Phone</th><th class="num">Active sites</th><th class="num">Active contracts</th></tr></thead>
        <tbody>
          <% for (const c of clients) { %>
            <tr>
              <td><a href="/clients/<%= c.id %>"><strong><%= c.name %></strong></a><% if (c.address) { %><br><span class="muted"><%= c.address %></span><% } %></td>
              <td><%= c.contact_name || '—' %><% if (c.contact_email) { %><br><span class="muted"><%= c.contact_email %></span><% } %></td>
              <td class="nowrap"><%= c.contact_phone || '—' %></td>
              <td class="num"><%= c.site_count %></td>
              <td class="num"><%= c.contract_count %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/bottom') %>
