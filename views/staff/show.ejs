<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/staff">← Staff</a></p>
    <h1><%= employee.first_name %> <%= employee.last_name %> <%- statusBadge(employee.status) %></h1>
    <p class="page-sub"><%= [employee.position, employee.employment_type].filter(Boolean).join(' · ') || 'No position set' %></p>
  </div>
  <div class="page-actions">
    <a class="btn" href="/schedule/new?employee=<%= employee.id %>">Add shift</a>
    <a class="btn" href="/timesheets/new?employee=<%= employee.id %>">Add hours</a>
    <a class="btn btn-primary" href="/staff/<%= employee.id %>/edit">Edit</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-label">Scheduled this week</span><span class="stat-value"><%= fmtHours(scheduledThisWeek) %></span><span class="stat-note">hours</span></div>
  <div class="stat"><span class="stat-label">Worked this week</span><span class="stat-value"><%= fmtHours(hoursThisWeek) %></span><span class="stat-note">hours in timesheets</span></div>
  <% if (locals.isAdmin) { %>
    <% if (employee.tax_form === 'W-2' && employee.pay_basis === 'salary') { %>
      <div class="stat"><span class="stat-label">Salary</span><span class="stat-value"><%= money(employee.annual_salary) %></span><span class="stat-note">a year<%= employee.overtime_exempt ? ', exempt' : '' %></span></div>
    <% } else { %>
      <div class="stat"><span class="stat-label">Hourly rate</span><span class="stat-value"><%= money(employee.hourly_rate) %></span><span class="stat-note">per hour</span></div>
    <% } %>
  <% } %>
  <div class="stat <%= compliance.level === 'bad' ? 'is-bad' : (compliance.level === 'warn' ? 'is-warn' : '') %>">
    <span class="stat-label">Compliance</span>
    <span class="stat-value"><%= compliance.level === 'ok' ? 'OK' : (compliance.level === 'warn' ? 'Expiring' : 'Problem') %></span>
    <span class="stat-note"><%= compliance.problems.length %> problem(s), <%= compliance.warnings.length %> expiring</span>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <div class="card-head"><h2>Details</h2></div>
    <dl class="dl">
      <dt>Email</dt><dd><%= employee.email || '—' %></dd>
      <dt>Phone</dt><dd><%= employee.phone || '—' %></dd>
      <dt>Address</dt><dd><%= employee.address || '—' %></dd>
      <dt>Emergency contact</dt><dd><%= [employee.emergency_contact_name, employee.emergency_contact_phone].filter(Boolean).join(' · ') || '—' %></dd>
      <dt>Started</dt><dd><%= employee.start_date ? fmtDate(employee.start_date) : '—' %></dd>
      <% if (employee.end_date) { %><dt>Finished</dt><dd><%= fmtDate(employee.end_date) %></dd><% } %>
      <dt>License number</dt><dd><%= employee.license_number || '—' %></dd>
      <dt>License expiry</dt><dd><%= employee.license_expiry ? fmtDate(employee.license_expiry) : '—' %></dd>
      <% if (employee.notes) { %><dt>Notes</dt><dd class="pre"><%= employee.notes %></dd><% } %>
      <dt>Sign-in account</dt><dd><% if (account) { %><%= account.email %> · <%= ROLE_NAMES[account.role] %><%= account.last_login_at ? ` · last in ${fmtDate(account.last_login_at)}` : '' %><% } else { %><span class="muted">None. They can sign up at /register; then link them under User accounts.</span><% } %></dd>
      <% if (account && account.role === 'officer') { %>
        <dt>App notifications</dt>
        <dd>
          <% if (account.devices) { %>On (<%= account.devices %> device<%= account.devices === 1 ? '' : 's' %>)<% } else if (account.push_exempt) { %>Off: the office let them use DMI without notifications, so they don't get shift reminders or open shifts.<% } else { %><span class="muted">Off: they're asked to turn them on before they can use DMI.</span><% } %>
          <% if (!account.devices) { %>
            <form method="post" action="/staff/<%= employee.id %>/notifications" class="inline-form">
              <%- include('../partials/csrf') %>
              <input type="hidden" name="exempt" value="<%= account.push_exempt ? '0' : '1' %>">
              <button type="submit" class="btn btn-sm btn-ghost"><%= account.push_exempt ? 'Require notifications again' : "Their phone can't: let them in without" %></button>
            </form>
          <% } %>
        </dd>
      <% } %>
      <% if (locals.isAdmin) { %>
        <dt>How they're paid</dt>
        <dd>
          <strong><%= employee.employment_type %></strong> <a class="btn btn-sm btn-ghost" href="/staff/<%= employee.id %>/edit">Change</a>
          <ul class="pay-rules small"><% for (const line of payRules) { %><li><%= line %></li><% } %></ul>
          <% if (payHistory.length) { %>
            <details class="small"><summary>Pay history</summary>
              <ul class="plain-list"><% for (const c of payHistory) { %><li><%= fmtDate(c.changed_on) %>: <%= c.summary %><span class="muted"><%= c.changed_by_name ? ` (${c.changed_by_name})` : '' %></span></li><% } %></ul>
            </details>
          <% } %>
        </dd>
        <% if (employee.tax_form === 'W-2') { %>
          <dt>New hire report (DE 34)</dt>
          <dd><% if (employee.new_hire_reported_on) { %>Reported to the EDD <%= fmtDate(employee.new_hire_reported_on) %><% } else if (!employee.start_date && !employee.w2_since) { %><span class="muted">Add their start date (needed for this report and for paid sick leave).</span><% } else { %>Due <%= fmtDate(newHireDue) %> (20 days after they <%= employee.w2_since ? 'became an employee' : 'started' %>)<% } %>
            <a class="btn btn-sm btn-ghost" href="/staff/<%= employee.id %>/new-hire"><%= employee.new_hire_reported_on ? 'Details' : 'Report details' %></a></dd>
          <dt>W-4 and DE 4</dt><dd><% if (w4) { %><%= w4Summary %> · SSN …<%= w4.ssn_last4 %> · signed <%= fmtDate(w4.signed_at) %><%= w4.entered_by ? ' (entered from paper)' : '' %><% } else { %><span class="muted">Not filled in yet: taxes are worked out as single, with no adjustments.</span><% } %>
            <a class="btn btn-sm btn-ghost" href="/staff/<%= employee.id %>/withholding"><%= w4 ? 'Change from paper forms' : 'Enter from paper forms' %></a></dd>
        <% } %>
        <dt>Direct deposit</dt>
        <dd>
          <% if (bankAccounts.active) { %><%= describeAccount(bankAccounts.active) %> (<%= bankAccounts.active.holder_name %>)<% } else { %><span class="muted">None: paid by check.</span><% } %>
          <a class="btn btn-sm btn-ghost" href="/staff/<%= employee.id %>/bank">Enter from signed form</a>
          <% if (bankAccounts.pending) { %>
            <div class="flash flash-warning bank-pending">
              <strong>New account to approve:</strong> <%= describeAccount(bankAccounts.pending) %> (<%= bankAccounts.pending.holder_name %>), entered by them <%= fmtDateTime(bankAccounts.pending.created_at) %>.
              Check with <%= employee.first_name %> that it was them (in person or by phone) before approving.
              <div class="btn-row">
                <form method="post" action="/staff/<%= employee.id %>/bank/approve" class="inline-form"><%- include('../partials/csrf') %><button type="submit" class="btn btn-sm btn-primary">Approve</button></form>
                <form method="post" action="/staff/<%= employee.id %>/bank/reject" class="inline-form"><%- include('../partials/csrf') %><button type="submit" class="btn btn-sm">Turn down</button></form>
              </div>
            </div>
          <% } %>
          <% if (bankAccounts.active) { %>
            <form method="post" action="/staff/<%= employee.id %>/bank/stop" class="inline-form" data-confirm="Stop direct deposit and pay them by check?"><%- include('../partials/csrf') %><button type="submit" class="btn btn-sm btn-ghost">Stop (paper checks)</button></form>
          <% } %>
        </dd>
        <% if (employee.tax_form !== 'W-2') { %>
          <dt>W-9 details</dt><dd><% if (taxProfile) { %>On file (<%= taxProfile.tin_type %> …<%= taxProfile.tin_last4 %>), signed <%= fmtDate(taxProfile.signed_at) %> · gets 1099 <%= taxProfile.electronic_consent ? 'online' : 'on paper' %><%= taxProfile.backup_withholding ? ' · subject to backup withholding' : '' %><% } else { %><span class="muted">Not filled in yet (they do it under Tax forms in their account)</span><% } %></dd>
        <% } %>
      <% } %>
    </dl>
  </section>

  <section class="card">
    <div class="card-head"><h2>Compliance</h2><a href="/training/records/new?employee=<%= employee.id %>">Add training record →</a></div>
    <% if (!compliance.items.length) { %>
      <p class="empty">Nothing required. Mark courses as "required" under Training → Courses.</p>
    <% } else { %>
      <ul class="list">
        <% for (const item of compliance.items) { %>
          <li><span><%= item.label %></span><%- complianceBadge(item.status, item.expires_on) %></li>
        <% } %>
      </ul>
    <% } %>
  </section>
</div>

<section class="card">
  <div class="card-head"><h2>Upcoming shifts</h2><a href="/schedule?employee=<%= employee.id %>">See in schedule →</a></div>
  <% if (!upcomingShifts.length) { %>
    <p class="empty">No upcoming shifts.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Time</th><th>Site</th><th>Client</th></tr></thead>
        <tbody>
          <% for (const s of upcomingShifts) { %>
            <tr>
              <td class="nowrap"><a href="/schedule/<%= s.id %>/edit"><%= fmtDay(s.start_at) %></a></td>
              <td class="nowrap"><%= fmtRange(s.start_at, s.end_at) %></td>
              <td><%= s.site_name %></td>
              <td><%= s.client_name %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="card-head"><h2>Availability</h2><a href="/schedule/availability">Everyone's →</a></div>
  <% if (!said.length) { %>
    <p class="empty">Nothing coming up. Officers add this themselves under My availability.</p>
  <% } else { %>
    <ul class="availability-list">
      <% for (const e of said) { %>
        <li><span><%- e.kind === 'unavailable' ? badge("Can't work", 'gray') : badge('Available', 'green') %> <%= e.label %><% if (e.note) { %> <span class="muted">· <%= e.note %></span><% } %></span></li>
      <% } %>
    </ul>
  <% } %>
</section>

<section class="card">
  <div class="card-head"><h2>Recent hours</h2><a href="/timesheets?status=all&employee=<%= employee.id %>">All hours →</a></div>
  <% if (!recentEntries.length) { %>
    <p class="empty">No hours recorded yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Time</th><th>Site</th><th class="num">Hours</th><th>Status</th></tr></thead>
        <tbody>
          <% for (const t of recentEntries) { %>
            <tr>
              <td class="nowrap"><%= fmtDay(t.start_at) %></td>
              <td class="nowrap"><%= fmtRange(t.start_at, t.end_at) %><%= t.break_minutes ? ` (${t.break_minutes} min break)` : '' %></td>
              <td><%= t.site_name || '—' %></td>
              <td class="num"><%= fmtHours(hoursBetween(t.start_at, t.end_at, t.break_minutes)) %></td>
              <td><%- statusBadge(t.status) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="card-head"><h2>Training records</h2><a href="/training/records/new?employee=<%= employee.id %>">Add →</a></div>
  <% if (!training.length) { %>
    <p class="empty">No training recorded yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Course</th><th>Completed</th><th>Expiry</th><th>Certificate</th><th></th></tr></thead>
        <tbody>
          <% for (const r of training) { %>
            <tr>
              <td><strong><%= r.course_name %></strong><% if (r.provider) { %><br><span class="muted"><%= r.provider %></span><% } %></td>
              <td class="nowrap"><%= fmtDate(r.completed_on) %></td>
              <td><%- r.expires_on ? expiryBadge(r.expires_on, settings.expiry_warning_days) : badge('No expiry', 'gray') %></td>
              <td><%= r.certificate_number || '' %>
                <% if (r.file_name) { %><a href="/training/records/<%= r.id %>/file" class="file-link"><%- icon('paperclip') %> <%= r.file_original %></a><% } %>
              </td>
              <td class="actions"><a href="/training/records/<%= r.id %>/edit">Edit</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="card-head"><h2>Contracts &amp; agreements</h2><a href="/contracts/new?employee=<%= employee.id %>">Add →</a></div>
  <% if (!contracts.length) { %>
    <p class="empty">No contracts on file.</p>
  <% } else { %>
    <ul class="list">
      <% for (const k of contracts) { %>
        <li><a href="/contracts/<%= k.id %>"><strong><%= k.title %></strong></a><span class="muted"><%= k.contract_type %></span><%- contractBadge(k, settings.expiry_warning_days) %></li>
      <% } %>
    </ul>
  <% } %>
</section>

<details class="danger-zone">
  <summary>Delete this staff member</summary>
  <p>Only possible if they have no shifts, hours, training or contracts on record. Usually it's better to set their status to <strong>Inactive</strong>.</p>
  <form method="post" action="/staff/<%= employee.id %>/delete" data-confirm="Delete <%= employee.first_name %> <%= employee.last_name %> permanently?">
    <%- include('../partials/csrf') %>
    <button type="submit" class="btn btn-danger">Delete permanently</button>
  </form>
</details>
<%- include('../partials/bottom') %>
