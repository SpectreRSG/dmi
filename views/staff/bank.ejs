<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/staff/<%= employee.id %>">← <%= employee.first_name %> <%= employee.last_name %></a></p>
    <h1>Direct deposit for <%= employee.first_name %> <%= employee.last_name %></h1>
    <p class="page-sub">Type in the account from the direct deposit form they signed (keep the form). It's used from the next pay run, and they get a notification.</p>
  </div>
</div>
<%- include('../partials/form-error') %>
<form method="post" action="/staff/<%= employee.id %>/bank" class="card form-card narrow" autocomplete="off">
  <%- include('../partials/csrf') %>
  <%- include('../partials/bank-form', { office: true }) %>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-ghost" href="/staff/<%= employee.id %>">Cancel</a>
  </div>
</form>
<%- include('../partials/bottom') %>
