<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="page-sub"><a href="/users">← User accounts</a></p>
    <h1><%= title %></h1>
    <% if (user.approving) { %><p class="page-sub">Signed up as <%= user.requested_role === 'client' ? 'a client' : 'a security officer' %>. Choose their role and press Save to let them in.</p><% } %>
  </div>
</div>
<%- include('../partials/form-error') %>
<form method="post" action="<%= user.id ? `/users/${user.id}` : '/users' %>" class="card form-card narrow">
  <%- include('../partials/csrf') %>
  <div class="form-grid">
    <label>Name <input name="name" value="<%= user.name || '' %>" required></label>
    <label>Email (used to sign in) <input type="email" name="email" value="<%= user.email || '' %>" required autocomplete="off"></label>
    <label>Phone <input type="tel" name="phone" value="<%= user.phone || '' %>"></label>
    <label>Role
      <select name="role" data-party-select>
        <% for (const role of ROLES) { %><option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= ROLE_NAMES[role] %></option><% } %>
      </select>
    </label>
    <label class="field-full" data-party="officer">Their staff record
      <select name="employee_id">
        <option value="">Choose…</option>
        <option value="new" <%= user.new_employee ? 'selected' : '' %>>+ Make a new staff record for this person</option>
        <% for (const e of staff) { %><option value="<%= e.id %>" <%= user.employee_id === e.id ? 'selected' : '' %>><%= e.last_name %>, <%= e.first_name %><%= e.email ? ` (${e.email})` : '' %></option><% } %>
      </select>
      <span class="hint">Links the account to the officer's shifts, hours and pay.</span>
    </label>
    <label class="field-full" data-party="client">Client
      <select name="client_id">
        <option value="">Choose…</option>
        <% for (const c of clients) { %><option value="<%= c.id %>" <%= user.client_id === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
      </select>
      <span class="hint">They'll see the schedule for this client's sites.</span>
    </label>
    <% if (user.id) { %>
      <label class="check field-full"><input type="checkbox" name="active" value="1" <%= user.active ? 'checked' : '' %>> Account is active (untick to block sign-in)</label>
    <% } %>
  </div>
  <h2><%= user.id ? 'Reset password (optional)' : 'Password' %></h2>
  <div class="form-grid">
    <label><%= user.id ? 'New password' : 'Password' %>
      <input type="password" name="password" minlength="10" autocomplete="new-password" <%= user.id ? '' : 'required' %>>
      <span class="hint">At least 10 characters.<%= user.id ? ' Leave empty to keep the current password.' : '' %></span>
    </label>
    <label>Type it again <input type="password" name="confirm" minlength="10" autocomplete="new-password" <%= user.id ? '' : 'required' %>></label>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-ghost" href="/users">Cancel</a>
  </div>
</form>
<%- include('../partials/bottom') %>
